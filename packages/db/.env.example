# Prisma CLI (migrations) — packages/db/.env
# Postgres connection string. On Supabase use the session-mode pooler (port 5432).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Direct connection used by Prisma tooling (Supabase transaction-mode pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
