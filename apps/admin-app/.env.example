# Copy to apps/admin-app/.env and fill in. Reuse the same DB + auth secret as apps/web.
DATABASE_URL=
DIRECT_URL=
BETTER_AUTH_SECRET=
# admin-app serves its own auth on port 3001
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
# comma-separated emails allowed into the admin CMS
ADMIN_EMAILS=you@example.com
# only if Google sign-in is used on admin too
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
