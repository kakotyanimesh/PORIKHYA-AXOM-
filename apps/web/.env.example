# Student app — apps/web/.env

# Database (runtime Prisma reads this; same value as packages/db/.env)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Better Auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (only if Google sign-in is enabled)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email — Resend (transactional). Verification will not send without these.
RESEND_API_KEY="re_xxxxxxxx"
# Until you verify a domain in Resend, use onboarding@resend.dev
RESEND_FROM="PorikhyaAxom <onboarding@resend.dev>"

# Payments — Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
